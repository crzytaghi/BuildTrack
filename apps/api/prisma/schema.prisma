generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String     @id @default(uuid())
  name                 String
  address              String?
  phone                String?
  timezone             String?
  companySetupComplete Boolean    @default(false)
  users                User[]
  projects             Project[]
  vendors              Vendor[]
  categories           Category[]
  documents            Document[]
  invoices             Invoice[]
}

model User {
  id           String    @id
  email        String    @unique
  name         String
  passwordHash String
  passwordSalt String
  createdAt    String
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  sessions     Session[]
}

model Session {
  token     String @id
  userId    String
  expiresAt Float
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String           @id
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  name        String
  status      String           @default("planning")
  startDate   String?
  endDate     String?
  budgetTotal Float?
  notes       String?
  tasks       Task[]
  expenses    Expense[]
  lineItems   BudgetLineItem[]
  quotes      Quote[]
  documents   Document[]
  invoices    Invoice[]

  @@index([companyId])
}

model Document {
  id        String   @id
  companyId String
  projectId String?
  title     String
  type      String   @default("other")
  fileKey   String
  fileName  String
  fileSize  Int
  mimeType  String
  notes     String?
  createdAt String
  company   Company  @relation(fields: [companyId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
}

model Task {
  id        String  @id
  projectId String
  title     String
  status    String  @default("todo")
  dueDate   String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Category {
  id        String           @id
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  name      String
  expenses  Expense[]
  lineItems BudgetLineItem[]

  @@index([companyId])
}

model Vendor {
  id          String    @id
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  trade       String?
  contactName String?
  phone       String?
  email       String?
  notes       String?
  expenses    Expense[]
  quotes      Quote[]

  @@index([companyId])
}

model Expense {
  id              String          @id
  projectId       String
  amount          Float
  categoryId      String
  vendorId        String
  description     String
  expenseDate     String
  lineItemId      String?
  receiptFileKey  String?
  receiptFileName String?
  receiptMimeType String?
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id])
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  lineItem        BudgetLineItem? @relation(fields: [lineItemId], references: [id])

  @@index([projectId])
  @@index([categoryId])
  @@index([vendorId])
}

model BudgetLineItem {
  id             String    @id
  projectId      String
  categoryId     String
  description    String
  budgetedAmount Float
  notes          String?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category       Category  @relation(fields: [categoryId], references: [id])
  expenses       Expense[]
  quotes         Quote[]

  @@index([projectId])
}

model Quote {
  id          String         @id
  lineItemId  String
  projectId   String
  vendorId    String
  amount      Float
  status      String         @default("pending")
  description String?
  expiresAt   String?
  submittedAt String
  lineItem    BudgetLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor      Vendor         @relation(fields: [vendorId], references: [id])

  @@index([lineItemId])
  @@index([projectId])
}

model Invoice {
  id            String          @id
  companyId     String
  projectId     String
  invoiceNumber String
  status        String          @default("draft")
  clientName    String
  clientEmail   String
  clientAddress String?
  dueDate       String?
  sentAt        String?
  paidAt        String?
  notes         String?
  createdAt     String
  updatedAt     String
  company       Company         @relation(fields: [companyId], references: [id])
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineItems     InvoiceLineItem[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model InvoiceLineItem {
  id          String  @id
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
